{
  "name": "web-agent-machine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "serve": "node scripts/serve.mjs",
    "test:deployed": "BASE_URL=https://artsrun.github.io/web-agent-machine playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.9.3"
  },
  "description": "A capability-secured agent kernel that runs inside a browser tab"
}
